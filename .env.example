NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by background jobs (scheduled reporting sync, the
# weekly GoHighLevel report) that run without a signed-in user and so
# must bypass RLS. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for Vercel Cron requests. Generate a random value, set it
# here and in the Vercel project's environment variables; cron requests
# must send it as "Authorization: Bearer <value>".
CRON_SECRET=
# HTTPS GoHighLevel webhook that receives the weekly overview report.
GHL_WEEKLY_REPORT_WEBHOOK_URL=

# Google Ads server credentials
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud.
GOOGLE_ADS_REDIRECT_URI=https://your-production-domain/api/google-ads/callback
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_REDIRECT_URI=https://spine-nine-orpin.vercel.app/api/auth/microsoft-ads/callback

